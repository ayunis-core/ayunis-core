{
  "name": "ayunis-core-e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "playwright test --project=chromium",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "openapi:generate": "orval --config orval.config.ts",
    "test:ui": "playwright test --project=chromium --ui",
    "test:headed": "playwright test --project=chromium --headed",
    "pr-media:capture": "playwright test --project=pr-media",
    "report": "playwright show-report",
    "codegen": "playwright codegen",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "axios": "^1.13.2",
    "eslint": "^10.13.0",
    "eslint-plugin-playwright": "^2.12.1",
    "jiti": "^2.7.0",
    "orval": "^8.43.0",
    "pdfjs-dist": "^5.7.284",
    "pg": "^8.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
