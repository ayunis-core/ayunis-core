# Base URL of the running frontend. Slot 2 → 3021, slot 3 → 3031, etc.
# Backend and Mailcatcher URLs are derived from the slot offset; override
# individually only for non-slot targets (e.g. CI).
E2E_BASE_URL=http://localhost:3021
# E2E_API_URL=http://localhost:3020
# E2E_MAIL_URL=http://localhost:1100
