{
  "openapi": "3.0.0",
  "paths": {
    "/internal/core-connect/subscription-sync/organizations/{orgId}/preparations": {
      "post": {
        "operationId": "prepareExternalSubscription",
        "parameters": [
          {
            "name": "orgId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrepareExternalSubscriptionDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExternalSubscriptionPreparationDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "core-connect": []
          }
        ],
        "summary": "",
        "tags": [
          "ExternalSubscriptions"
        ]
      }
    },
    "/internal/core-connect/subscription-sync/organizations/{orgId}/state": {
      "post": {
        "operationId": "applyExternalSubscription",
        "parameters": [
          {
            "name": "orgId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-webhook-id",
            "required": false,
            "in": "header",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplyExternalSubscriptionDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExternalSubscriptionResultDto"
                }
              }
            }
          },
          "409": {
            "description": "Prepared state was superseded; read provider state again"
          }
        },
        "security": [
          {
            "core-connect": []
          }
        ],
        "summary": "",
        "tags": [
          "ExternalSubscriptions"
        ]
      }
    },
    "/internal/core-connect/subscription-sync/links": {
      "get": {
        "operationId": "listExternalSubscriptionLinks",
        "parameters": [
          {
            "name": "ownerId",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ExternalSubscriptionLinkDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "core-connect": []
          }
        ],
        "summary": "",
        "tags": [
          "ExternalSubscriptions"
        ]
      }
    },
    "/internal/core-connect/subscription-sync/lease": {
      "post": {
        "operationId": "coordinateExternalSubscriptions",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExternalSubscriptionLeaseDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExternalSubscriptionLeaseResultDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "core-connect": []
          }
        ],
        "summary": "",
        "tags": [
          "ExternalSubscriptions"
        ]
      }
    }
  },
  "info": {
    "title": "Core Connect internal API",
    "description": "",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "core-connect": {
        "scheme": "bearer",
        "bearerFormat": "opaque",
        "type": "http"
      }
    },
    "schemas": {
      "PrepareExternalSubscriptionDto": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "sync",
              "cleanup"
            ]
          }
        },
        "required": [
          "mode"
        ]
      },
      "ExternalSubscriptionPreparationDto": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "revision"
        ]
      },
      "ExternalBillingAddressDto": {
        "type": "object",
        "properties": {
          "companyName": {
            "type": "string"
          },
          "street": {
            "type": "string"
          },
          "houseNumber": {
            "type": "string"
          },
          "postalCode": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "vatNumber": {
            "type": "string"
          }
        },
        "required": [
          "companyName",
          "street",
          "houseNumber",
          "postalCode",
          "city",
          "country"
        ]
      },
      "ExternalSubscriptionDataDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "SEAT_BASED",
              "USAGE_BASED"
            ]
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "cancelledAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "noOfSeats": {
            "type": "number"
          },
          "monthlyCredits": {
            "type": "number"
          },
          "billingInfo": {
            "$ref": "#/components/schemas/ExternalBillingAddressDto"
          }
        },
        "required": [
          "type",
          "startsAt",
          "cancelledAt",
          "endsAt",
          "billingInfo"
        ]
      },
      "ApplyExternalSubscriptionDto": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "string",
            "format": "uuid"
          },
          "ownerId": {
            "type": "string"
          },
          "subscription": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/ExternalSubscriptionDataDto"
              }
            ]
          },
          "academyActive": {
            "type": "boolean"
          },
          "revoke": {
            "type": "boolean"
          }
        },
        "required": [
          "revision",
          "ownerId",
          "subscription",
          "academyActive",
          "revoke"
        ]
      },
      "ExternalSubscriptionResultDto": {
        "type": "object",
        "properties": {
          "changed": {
            "type": "boolean"
          }
        },
        "required": [
          "changed"
        ]
      },
      "ExternalSubscriptionLinkDto": {
        "type": "object",
        "properties": {
          "orgId": {
            "type": "string",
            "format": "uuid"
          },
          "ownerId": {
            "type": "string"
          }
        },
        "required": [
          "orgId",
          "ownerId"
        ]
      },
      "ExternalSubscriptionLeaseDto": {
        "type": "object",
        "properties": {
          "ownerId": {
            "type": "string",
            "format": "uuid"
          },
          "action": {
            "type": "string",
            "enum": [
              "acquire",
              "release"
            ]
          }
        },
        "required": [
          "ownerId",
          "action"
        ]
      },
      "ExternalSubscriptionLeaseResultDto": {
        "type": "object",
        "properties": {
          "acquired": {
            "type": "boolean"
          }
        },
        "required": [
          "acquired"
        ]
      }
    }
  }
}
