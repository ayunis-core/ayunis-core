      "ObjectInput": {
        "additionalProperties": false,
        "properties": {
          "bucket": {
            "minLength": 1,
            "title": "Bucket",
            "type": "string"
          },
          "key": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Key",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Sha256",
            "type": "string"
          }
        },
        "required": [
          "bucket",
          "key",
          "sha256"
        ],
        "title": "ObjectInput",
        "type": "object"
      },
      "ReleaseRequest": {
        "additionalProperties": false,
        "properties": {
          "orgId": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Orgid",
            "type": "string"
          },
          "sourceIds": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "maxItems": 1000,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sourceids"
          }
        },
        "required": [
          "orgId"
        ],
        "title": "ReleaseRequest",
        "type": "object"
      },
      "ReleaseResponse": {
        "additionalProperties": false,
        "properties": {
          "cancelled": {
            "title": "Cancelled",
            "type": "integer"
          },
          "released": {
            "title": "Released",
            "type": "integer"
          }
        },
        "required": [
          "released",
          "cancelled"
        ],
        "title": "ReleaseResponse",
        "type": "object"
      },
      "ResultRef": {
        "additionalProperties": false,
        "properties": {
          "bucket": {
            "title": "Bucket",
            "type": "string"
          },
          "bytes": {
            "title": "Bytes",
            "type": "integer"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "pageCount": {
            "title": "Pagecount",
            "type": "integer"
          },
          "sha256": {
            "title": "Sha256",
            "type": "string"
          }
        },
        "required": [
          "bucket",
          "key",
          "bytes",
          "sha256",
          "pageCount"
        ],
        "title": "ResultRef",
        "type": "object"
      },
      "StartJobRequest": {
        "additionalProperties": false,
        "properties": {
          "declaredMimeType": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Declaredmimetype",
            "type": "string"
          },
          "fileName": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Filename",
            "type": "string"
          },
          "idempotencyKey": {
            "pattern": "^[A-Za-z0-9:_-]{1,160}$",
            "title": "Idempotencykey",
            "type": "string"
          },
          "input": {
            "$ref": "#/components/schemas/ObjectInput"
          },
          "options": {
            "$ref": "#/components/schemas/JobOptions"
          },
          "output": {
            "$ref": "#/components/schemas/JobOutput"
          },
          "owner": {
            "$ref": "#/components/schemas/JobOwner"
          }
        },
        "required": [
          "idempotencyKey",
          "owner",
          "input",
          "fileName",
          "declaredMimeType",
          "output"
        ],
        "title": "StartJobRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
