{
  "components": {
    "schemas": {
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/JobFailure"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "contractVersion": {
            "title": "Contractversion",
            "type": "integer"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "contractVersion"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "JobFailure": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "title": "JobFailure",
        "type": "object"
      },
      "JobOptions": {
        "additionalProperties": false,
        "properties": {
          "languageHints": {
            "items": {
              "type": "string"
            },
            "maxItems": 8,
            "title": "Languagehints",
            "type": "array"
          },
          "maxPages": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Maxpages"
          },
          "ocr": {
            "default": "auto",
            "enum": [
              "auto",
              "always",
              "never"
            ],
            "title": "Ocr",
            "type": "string"
          }
        },
        "title": "JobOptions",
        "type": "object"
      },
      "JobOutput": {
        "additionalProperties": false,
        "properties": {
          "bucket": {
            "minLength": 1,
            "title": "Bucket",
            "type": "string"
          },
          "keyPrefix": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Keyprefix",
            "type": "string"
          }
        },
        "required": [
          "bucket",
          "keyPrefix"
        ],
        "title": "JobOutput",
        "type": "object"
      },
      "JobOwner": {
        "additionalProperties": false,
        "properties": {
          "orgId": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Orgid",
            "type": "string"
          },
          "sourceId": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Sourceid",
            "type": "string"
          }
        },
        "required": [
          "orgId",
          "sourceId"
        ],
        "title": "JobOwner",
        "type": "object"
      },
      "JobProgress": {
        "additionalProperties": false,
        "description": "Every counter is always present: the backend reads them without defaults.",
        "properties": {
          "pagesDone": {
            "title": "Pagesdone",
            "type": "integer"
          },
          "pagesOcr": {
            "title": "Pagesocr",
            "type": "integer"
          },
          "pagesText": {
            "title": "Pagestext",
            "type": "integer"
          },
          "pagesTotal": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pagestotal"
          }
        },
        "required": [
          "pagesTotal",
          "pagesDone",
          "pagesOcr",
          "pagesText"
        ],
        "title": "JobProgress",
        "type": "object"
      },
      "JobStatus": {
        "additionalProperties": false,
        "properties": {
          "attempt": {
            "title": "Attempt",
            "type": "integer"
          },
          "createdAt": {
            "title": "Createdat",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobFailure"
              },
              {
                "type": "null"
              }
            ]
          },
          "finishedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finishedat"
          },
          "idempotencyKey": {
            "title": "Idempotencykey",
            "type": "string"
          },
          "jobId": {
            "title": "Jobid",
            "type": "string"
          },
          "phase": {
            "anyOf": [
              {
                "enum": [
                  "downloading",
                  "converting",
                  "counting",
                  "analyzing",
                  "extracting",
                  "finalizing"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phase"
          },
          "progress": {
            "$ref": "#/components/schemas/JobProgress"
          },
          "restarts": {
            "title": "Restarts",
            "type": "integer"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ResultRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "startedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Startedat"
          },
          "state": {
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled"
            ],
            "title": "State",
            "type": "string"
          },
          "updatedAt": {
            "title": "Updatedat",
            "type": "string"
          }
        },
        "required": [
          "jobId",
          "idempotencyKey",
          "state",
          "phase",
          "attempt",
          "restarts",
          "progress",
          "result",
          "error",
          "createdAt",
          "startedAt",
          "updatedAt",
          "finishedAt"
